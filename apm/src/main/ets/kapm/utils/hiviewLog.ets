import { hidebug } from '@kit.PerformanceAnalysisKit';

export interface HiviewDeviceAppInfo {
  brand?: string;
  deviceType?: string;
  buildId?: string;
  osVersion?: string;
  bundleName?: string;
  appVersion?: string;
}

export interface BuildHiviewJsErrorLogArgs {
  now: number;
  fingerprint: string;
  name: string;
  message: string;
  stack: string;
  foreground: boolean;
  errorCode?: string | number;
  hilog?: string[];
  versionCode?: number;
  info: HiviewDeviceAppInfo;
}

function formatHiviewTimestamp(ms: number): string {
  const d = new Date(ms);
  const pad2 = (n: number) => (n < 10 ? `0${n}` : `${n}`);
  const pad3 = (n: number) => (n < 10 ? `00${n}` : (n < 100 ? `0${n}` : `${n}`));
  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}.${pad3(d.getMilliseconds())}`;
}

/**
 * 生成与系统 HiViewDFX 文本风格一致的 JS Error 日志（用于 external_log 落盘/上传）
 */
export function buildHiviewJsErrorLog(args: BuildHiviewJsErrorLogArgs): string {
  const deviceInfoStr = `${args.info.brand || 'Unknown'} ${args.info.deviceType || ''}`.trim();
  const buildInfoStr = `${args.info.buildId || 'Unknown'} ${args.info.osVersion || 'Unknown'}`.trim();
  const moduleName = args.info.bundleName || 'unknown';
  const version = args.info.appVersion || 'unknown';
  const fg = args.foreground ? 'Yes' : 'No';

  const reasonLine = 'Error';
  const errName = args.name || 'Error';
  const errMessage = args.message || 'Unknown reason';
  const errCode = args.errorCode === undefined ? '' : String(args.errorCode);

  const stackLines = (args.stack || '')
    .split('\n')
    .filter(line => line.trim().length > 0)
    .map(line => `    ${line}`)
    .join('\n');

  // const hilogLines = (args.hilog && args.hilog.length > 0)
  //   ? args.hilog.map(line => String(line)).join('\n')
  //   : '';

  const systemMemInfo: hidebug.SystemMemInfo = hidebug.getSystemMemInfo();
  const nativeMemInfo: hidebug.NativeMemInfo = hidebug.getAppNativeMemInfo();

  return [
    'Generated by HarmonyOS-APM',
    '================================================================',
    `Device info:${deviceInfoStr}`,
    `Build info:${buildInfoStr}`,
    `Fingerprint:${args.fingerprint}`,
    `Timestamp:${formatHiviewTimestamp(args.now)}`,
    `Module name:${moduleName}`,
    `Version:${version}`,
    `Foreground:${fg}`,
    `Process Memory(kB): ${nativeMemInfo.pss}(Rss)`,
    `Device Memory(kB): Total ${systemMemInfo.totalMem}, Free ${systemMemInfo.freeMem}, Available ${systemMemInfo.availableMem}`,
    `Reason:${reasonLine}`,
    `Error name:${errName}`,
    `Error message:${errMessage}`,
    `Error code:${errCode}`,
    'Stacktrace:',
    'Cannot get SourceMap info, dump raw stack:',
    stackLines,
    '',
    // 'HiLog:',
    // hilogLines,
    // '',
  ].join('\n');
}



{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "<YOUR_CERT_PATH>.cer",
          "keyAlias": "debugKey",
          "keyPassword": "<YOUR_KEY_PASSWORD>",
          "profile": "<YOUR_PROFILE_PATH>.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<YOUR_KEYSTORE_PATH>.p12",
          "storePassword": "<YOUR_STORE_PASSWORD>"
        }
      }
    ],
    "products": [
       {
         "name": "default",
         "targetSdkVersion": "6.0.0(20)",
         "compatibleSdkVersion": "6.0.0(20)",
         "runtimeOS": "HarmonyOS",
         "signingConfig": "default",
         "buildOption": {
           "strictMode": {
             "caseSensitiveCheck": true,
             "useNormalizedOHMUrl": true
           }
         }
       }
     ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "apm",
      "srcPath": "./apm",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "native_error_demo",
      "srcPath": "./native_error_demo",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}